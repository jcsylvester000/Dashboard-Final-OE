# OverEasy Dashboard - production .env template for Laravel Forge.
# Copy into Forge > Site > Environment and fill the blanks. Never commit real values.

APP_NAME="OverEasy Dashboard"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show (once), then keep it forever
APP_DEBUG=false
APP_URL=https://dashboard.example.com
APP_TIMEZONE=Asia/Manila      # the team's local zone: "today", due dates and overdue alerts follow it. Set once, before go-live.

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=overeasy
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log      # set to reverb once Reverb is installed and its daemon runs
MAIL_MAILER=log               # the app never sends email

CSP_ENABLED=true

# First Super Admin (used by the seeder once)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

# PDFs
BILLING_COMPANY_NAME="${APP_NAME}"
BILLING_COMPANY_ADDRESS=
BILLING_COMPANY_TIN=
BILLING_COMPANY_CONTACT=

# Files
FILES_DRIVER=local
FILES_MAX_MB=25
FILES_LINK_MINUTES=10

# API
API_PER_MINUTE=120
API_MAX_TOKEN_DAYS=365
