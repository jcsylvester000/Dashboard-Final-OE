includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 6

    # Vendor-published Pulse migration (unchanged upstream code; its match() on the
    # database driver has no default arm by design).
    excludePaths:
        - database/migrations/*_create_pulse_tables.php
